# Server-only configuration. Never expose these values to the browser build.
MIREYE_API_TOKEN=
NASS_API_KEY=
DATABASE_URL=

# Local defaults; set WEB_ORIGIN to the deployed static-site URL in production.
HTTP_ADDRESS=:8080
WEB_ORIGIN=http://localhost:5174
LOG_LEVEL=INFO

# Browser map. Defaults to OpenStreetMap when unset; keep attribution visible when changing providers.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
# Optional ArcGIS WMS overlays on the parcel map (defaults: MiEnviro Part 201 Sites, CWS Intakes,
# Cold/Transitional Streams, Part 115 Landfills). Format: Label|WMSServer-URL|layerIds|opacity;...
# e.g. VITE_MAP_OVERLAYS="PFAS Sites|https://gisagoegle.state.mi.us/arcgis/services/EGLE/PfasOpenData/MapServer/WMSServer|0|0.85"
VITE_MAP_OVERLAYS=
