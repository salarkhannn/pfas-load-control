/bin/
/coverage.out
*.prof

# Frontend dependencies and generated output
/web/node_modules/
/web/dist/
/web/playwright-report/
/web/test-results/
*.tsbuildinfo

# Editor and operating-system files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
*~
